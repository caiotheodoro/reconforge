# ReconForge environment template (copy to .env and fill)

# --- Temporal Cloud ---
TEMPORAL_CLOUD_API_KEY=
TEMPORAL_CLOUD_ACCOUNT_ID=
TEMPORAL_NAMESPACE=
TEMPORAL_HOST=

# --- Model provider (DeepSeek API) ---
MODEL_PROVIDER_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER_MODEL_ID=
MODEL_PROVIDER_API_KEY=

# --- Infra ---
POSTGRES_USER=reconforge
POSTGRES_PASSWORD=reconforge_local
POSTGRES_DB=reconforge
POSTGRES_PORT=5432
NEO4J_AUTH=neo4j/reconforge_local
KAFKA_BROKER=localhost:9092
REDIS_URL=redis://localhost:6379/0

# --- Local model service ---
MODEL_SERVICE_URL=http://localhost:9100/v1
MLX_BASE_MODEL=Qwen/Qwen3-1.7B

# --- Hugging Face (set before uploading model cards) ---
HF_TOKEN=
